# 복사해서 .env 로 쓴다. .env 는 gitignore 대상이며 값은 절대 커밋하지 않는다.
# 키 발급·전달 규칙은 SECURITY.md 참고.

# 네이버 검색 API (지오코딩). 비밀. 개발자 PC에서만 쓴다.
# 2026-06부터 NAVER API HUB(네이버 클라우드 콘솔)에서 발급. 헤더 X-NCP-APIGW-API-KEY-ID / X-NCP-APIGW-API-KEY,
# 엔드포인트 https://naverapihub.apigw.ntruss.com/search/v1/local (개발자센터 구형 키는 2027-06-30 종료).
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# 공공데이터포털 인허가 조회서비스 (지오코딩 좌표 보강·폐업 대조). 비밀. 개발자 PC에서만 쓴다.
# localdata.go.kr은 2026-04-16 종료. 행정안전부_식품_* 조회서비스(apis.data.go.kr/1741000/{업종}/info)를 쓴다.
# 서비스마다 활용신청(자동승인)하고 디코딩 키를 넣는다. 인코딩 키를 넣으면 인증 오류가 난다.
DATA_GO_KR_KEY=

# Gemini (헤더 매핑·비식당 판별). 비밀. 개발자 PC에서만 쓴다.
GEMINI_API_KEY=
# 2.5 Flash는 2026-09 기준 신규 계정에 닫혔다. 3.x는 thinking_budget 대신 thinkingLevel=minimal 로 끈다.
GEMINI_MODEL=gemini-3.6-flash

# 네이버 지도 클라이언트 키. 공개되어도 되는 키(도메인 allowlist로 보호).
# 사이트 빌드에 들어가므로 Actions에서는 Variables(비밀 아님)로 둔다.
NAVER_MAP_CLIENT_ID=

# Cloudflare Pages (CI 배포). 토큰·Account ID는 GitHub Secrets, 프로젝트명은 Variables.
# scripts/sync-github.sh 가 .env 의 이 값들을 GitHub 에 올린다.
CLOUDFLARE_PAGES_PROJECT=officialdeliciousmap
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# 지도 스크립트 파라미터 이름. 신규 발급 키는 ncpKeyId, 구형은 ncpClientId.
NAVER_MAP_KEY_PARAM=ncpKeyId
